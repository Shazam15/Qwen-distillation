# ---------------------------------------------------------------------------
# atlas-distill environment config - copy this to .env and fill in the blanks.
#
# Load it into your shell before running any script (none of the scripts auto-source it):
#   set -a && source .env && set +a
# `set -a` exports every variable this file defines so both the bash scripts'
# ${VAR:-default} lookups and Python's os.environ.get(...) calls can see them;
# `set +a` turns that back off afterward.
#
# This file holds STABLE, cross-phase config only - infra paths, model tags,
# credentials. Per-run hyperparameters (LEARNING_RATE, EPOCHS, PROJECT_NAME, BATCH_SIZE,
# GRAD_ACCUM) deliberately do NOT live here: f_train_qlora.sh and l_dpo_train.sh need
# DIFFERENT values for those same names (e.g. LEARNING_RATE=2e-4 for SFT vs 5e-6 for DPO).
# If both scripts read from one shared value, whichever you set applies to both. Pass
# those inline per invocation instead, e.g.:
#   EPOCHS=1 LEARNING_RATE=5e-6 PROJECT_NAME=atlas-distill-v1-dpo ./scripts/l_dpo_train.sh
#
# Run scripts/00_preflight_check.py before any of this to confirm the machine (GPU,
# RAM, disk, Ollama) is actually ready - see docs/WINDOWS_SETUP.md if you're on Windows.
# ---------------------------------------------------------------------------

# --- Ollama ---
# Only needs to change if Ollama isn't running on its default local port.
OLLAMA_BASE_URL=http://localhost:11434

# The exact pull string for the teacher. a_setup_env.sh pulls this tag directly with
# `ollama pull`; c_generate_teacher_data.py's --model flag should match it exactly
# (no separate alias step exists - keep this one value as the single source of truth).
TEACHER_MODEL=hf.co/bartowski/Qwen3.8-Flash-Next-GGUF:Q4_K_M

# Current production baseline - used by g_evaluate.py (Phase 6) and l_build_dpo_dataset.py
# (Phase 11) as the comparison/rejected-sample model, and by a_setup_env.sh to confirm/pull
# it if missing.
STUDENT_MODEL=qwen3:14b-q4_K_M

# What j_create_ollama_model.sh names the finished model, and what k_swap_and_smoketest.sh
# writes into ATLAS's LLM_MODEL. Keep these two identical.
OLLAMA_TAG=atlas-qwen3-14b-distilled
NEW_MODEL_TAG=atlas-qwen3-14b-distilled

# --- Base model for training/merging (Hugging Face repo id, not an Ollama tag) ---
BASE_MODEL=Qwen/Qwen3-14B

# --- Hugging Face - only required if a dataset or model you add later is gated ---
HF_TOKEN=

# --- llama.cpp / GGUF conversion (i_convert_quantize.sh) ---
# Relative to the scripts/ directory by default; point this at an existing llama.cpp
# checkout if you already have one built, to skip the clone-and-build step.
LLAMA_CPP_DIR=../llama.cpp
QUANT_TYPE=Q4_K_M
MODEL_NAME=atlas-distill-v1

# --- Deploying into ATLAS (k_swap_and_smoketest.sh) ---
# Absolute path to your PDF-Assistant-RAG checkout - a different repo from this one.
# If ATLAS itself runs inside WSL2, this is a WSL2 path (e.g. /home/you/PDF-Assistant-RAG),
# NOT a Windows path (C:\Users\...) - the script runs under bash.
ATLAS_REPO_PATH=/absolute/path/to/PDF-Assistant-RAG

# How to restart the ATLAS backend after the env swap. Leave blank to be prompted to
# restart it manually instead of guessing your process manager.
#   RESTART_CMD=systemctl restart atlas-backend
#   RESTART_CMD=docker compose -f /path/to/PDF-Assistant-RAG/docker-compose.yml restart backend
RESTART_CMD=
